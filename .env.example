# Copy to .env and fill in. .env is gitignored; .env.example is not.
#
# These are read by the /api/critique middleware in plugins/critiqueApi.ts,
# which runs on the Vite dev/preview server. They are NOT prefixed with VITE_,
# which is deliberate: only VITE_-prefixed variables reach the browser bundle,
# and an API key must never be one of them.

# https://featherless.ai -- account settings -> API keys
FEATHERLESS_API_KEY=

# Exact model id from the Featherless catalogue, e.g. a Hugging Face repo id.
# No default: an unset model produces a clear error rather than a silent
# fallback to something you did not choose.
FEATHERLESS_MODEL=

# Override only if you are pointing at a different OpenAI-compatible provider.
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1


# --- Supabase -------------------------------------------------------------
#
# These two ARE prefixed with VITE_, which looks like it contradicts the note
# above. It does not. The anon (a.k.a. publishable) key is a public identifier
# by design and is meant to ship in the browser bundle; what stops a stranger
# reading your data is Row Level Security on the table, not secrecy of this
# key. Check that RLS is on before you ship, and treat it as the real boundary.
#
# The service_role (a.k.a. secret) key is the opposite: it bypasses RLS
# entirely. It must never appear in client code, in a VITE_ variable, or in
# this repo.
#
# Dashboard -> Project Settings -> API (newer projects: "API Keys")
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
